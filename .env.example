# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
# Comma-separated allowlist of browser origins for CORS.
CORS_ORIGINS=http://localhost:3000

# ─── Datastores ─────────────────────────────────────────────────────────────
# MongoDB MUST be a replica set (multi-document transactions require it).
MONGODB_URI=mongodb://localhost:27017/streetserve?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# ─── Managed Auth (Clerk / Auth0) — verified at the edge via JWKS ────────────
AUTH_PROVIDER=clerk
AUTH_JWKS_URL=https://your-tenant.clerk.accounts.dev/.well-known/jwks.json
AUTH_ISSUER=https://your-tenant.clerk.accounts.dev
AUTH_AUDIENCE=streetserve-api
# Shared secret used to verify inbound user-sync webhooks (Svix/Clerk or Auth0 hook).
AUTH_WEBHOOK_SECRET=whsec_replace_me

# ─── Rate limiting (applies platform-wide; tuned per route in code) ──────────
RATE_LIMIT_ENABLED=true

# ─── Observability ──────────────────────────────────────────────────────────
METRICS_ENABLED=true
OPENAPI_ENABLED=true

# ─── Payments (Stripe Connect + Stripe Tax) ─────────────────────────────────
# Optional in dev/test (tests inject a fake gateway); required to move real money.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_COUNTRY=US
PLATFORM_CURRENCY=usd
STRIPE_TAX_ENABLED=false

# ─── KYC (Stripe Identity / Persona) ────────────────────────────────────────
KYC_PROVIDER=stripe_identity
KYC_WEBHOOK_SECRET=replace_me_for_persona
# Dev only: approve ID verification instantly instead of waiting for the provider webhook (which
# can't fire without a real STRIPE_WEBHOOK_SECRET). Never honored in production. Leave false unless
# you're testing the verify → Bronze → checkout flow locally.
KYC_DEV_AUTO_APPROVE=false
# Dev/staging only: allow a customer to accept a rent-to-own agreement whose text is still the
# PLACEHOLDER pending attorney review. Never honored in production — the check is on isProd, so
# setting this on a live box changes nothing. Turn it on only to walk the RTO lifecycle end to end
# (accept → instalments → payoff), and re-collect those acceptances once the reviewed text lands:
# they are not enforceable. Leave false otherwise.
RTO_ALLOW_UNREVIEWED_AGREEMENT=false
KYC_RETURN_URL=http://localhost:3000/verify/complete
CONNECT_RETURN_URL=http://localhost:3000/payouts/complete
CONNECT_REFRESH_URL=http://localhost:3000/payouts/refresh

# ─── Object storage (Cloudflare R2 / S3-compatible) ─────────────────────────
# Optional in dev/test (tests inject a fake); required for real presigned uploads.
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=streetserve-media
R2_PUBLIC_BASE_URL=https://cdn.example.com
R2_REGION=auto

# ─── City scoping (pilot) ───────────────────────────────────────────────────
DEFAULT_CITY=modesto-ca

# ─── AI provider (Google Gemini) ────────────────────────────────────────────
# Optional: with no key the AI module uses the deterministic rule-based engine,
# which is fully functional on its own. Gemini adds the language layer only.
# Key from https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_me
# flash + flash-lite are on the free tier. Switch GEMINI_MODEL to gemini-2.5-pro once billing is enabled.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
# Budget per model call; on timeout the seller gets the deterministic copy instead of a hang.
GEMINI_TIMEOUT_MS=6000

# ─── Customer-facing fee flags (R8/R10/§32.4) ───────────────────────────────
# ALL OFF AT LAUNCH, on purpose — §33 asks for checkout to stay simple, and every
# one of these adds a line the customer has to read. They are ops toggles, not
# code changes: flipping one changes what customers are charged, so treat a
# change here as a pricing decision that needs sign-off.
#   customer service fee  — a % of goods, floored/capped by the fee registry
#   processing fee        — the processor's own rate, passed through
#   wave convenience fee  — the platform's flat fee on a Waved Down request
CUSTOMER_SERVICE_FEE_ENABLED=false
PROCESSING_FEE_ENABLED=false
WAVE_CONVENIENCE_FEE_ENABLED=false

# ─── Public base URL ────────────────────────────────────────────────────────
# Used to build customer-facing links (receipts, pay links, agreement copies).
# Get this wrong in production and every emailed link points at localhost.
APP_BASE_URL=http://localhost:3000

# ─── Optional feature-data providers ────────────────────────────────────────
# Both are optional inputs to the demand forecaster. Missing keys degrade the
# forecast; they never break it.
WEATHER_API_KEY=
TICKETMASTER_API_KEY=

# ─── Print / direct-mail vendor (PostcardMania "PCM Integrations") ──────────
# DirectMail API v3. Auth is a LOGIN EXCHANGE, not a static header: the key and
# secret are POSTed to /auth/login and traded for a short-lived bearer JWT, so
# BOTH halves are required — a key on its own cannot authenticate.
#
# Sandbox and production keys look IDENTICAL, so the credential cannot tell you
# which one you hold. PCM_ENVIRONMENT is the only guard, and boot refuses to
# start if it says `production` while NODE_ENV does not. A print run cannot be
# rolled back.
#
# Both values come from the portal: My Account -> API Keys. Put the SANDBOX pair
# in .env (gitignored); production comes from the platform secret store. Rotate
# at portal.pcmintegrations.com; never commit either.
#
# Note the host: v3.pcmintegrations.com. api.pcmintegrations.com only redirects
# to their docs.
PCM_API_KEY=
PCM_API_SECRET=
PCM_ENVIRONMENT=sandbox
PCM_API_BASE_URL=https://v3.pcmintegrations.com
# Signing secret for the vendor's status callbacks, IF one is ever configured in
# their portal. Optional, and the receiver fails OPEN without it — deliberately.
# The callback is only an accelerator: it carries no trusted data and can at most
# prompt a re-poll of an order we already own, so rejecting unsigned calls would
# disable it without adding security. Polling is what actually advances a mailing.
PCM_WEBHOOK_SECRET=
# The address side of every postcard. A buyer designs the front; a mailed piece
# needs a back and the vendor requires both, so the platform supplies it.
POSTCARD_BACK_TEMPLATE_URL=

# ─── Postcard sales tax (ADR-007 §5) ────────────────────────────────────────
# OFF until an accountant answers the merchant-of-record question. Under
# wholesale resale StreetServe is plausibly the merchant for a taxable
# print-and-mail service in every state it mails into — but that is not a tax
# position. Turning this on without wiring Stripe Tax fails loudly rather than
# inventing a rate. Treat a change here as a tax decision, not a deploy.
POSTCARD_TAX_ENABLED=false
