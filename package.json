{
  "name": "streetserve-backend",
  "version": "0.1.0",
  "private": true,
  "description": "StreetServe backend — Node + Express + TypeScript + MongoDB (Phase 0 Foundations)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <21"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "migrate-mongo up -f migrate-mongo-config.js",
    "migrate:down": "migrate-mongo down -f migrate-mongo-config.js",
    "migrate:status": "migrate-mongo status -f migrate-mongo-config.js",
    "seed": "tsx scripts/seed.ts",
    "grant-role": "tsx scripts/grant-role.ts",
    "audit:stripe": "tsx scripts/audit-stripe-accounts.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "audit:deps": "node scripts/check-vulnerabilities.mjs",
    "probe:print": "tsx scripts/print-vendor-probe.ts",
    "pilot:review": "tsx scripts/pilot-review.ts",
    "reconcile:placements": "tsx scripts/reconcile-placements.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.1.1",
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.6.3",
    "migrate-mongo": "^11.0.0",
    "mongoose": "^8.5.3",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.7.5",
    "stripe": "^16.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.14",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "ioredis-mock": "^8.9.0",
    "mongodb-memory-server": "^10.0.0",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
